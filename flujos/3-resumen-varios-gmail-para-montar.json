        "options": {}
      },
      "id": "05823e89-cddc-4477-adc9-6cb3a26e33da",
      "name": "Gemini",
      "type": "@n8n/n8n-nodes-langchain.lmChatGoogleGemini",
      "typeVersion": 1,
      "position": [
        1344,
        336
      ]
