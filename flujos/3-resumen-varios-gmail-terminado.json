      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "TU_CORREO@gmail.com",
        "subject": "=Resumen de tus correos · {{ $now.setLocale('es').toFormat(\"cccc d 'de' LLLL\") }}",
        "message": "=<div style=\"font-family:Arial,Helvetica,sans-serif;max-width:600px;margin:0 auto;color:#1f2937;font-size:14px;line-height:1.6\">\n  <div style=\"background:#111827;color:#ffffff;padding:16px 22px;border-radius:10px 10px 0 0;font-size:17px;font-weight:bold\">Resumen de tus correos</div>\n  <div style=\"border:1px solid #e5e7eb;border-top:0;border-radius:0 0 10px 10px;padding:20px 22px\">\n    {{ $('Analista IA').first().json.output.replace(/```html|```/g, '') }}\n  </div>\n  <p style=\"color:#6b7280;font-size:12px;text-align:center;margin-top:14px\">Generado automáticamente con n8n y Gemini.</p>\n</div>",
        "options": {
          "appendAttribution": false,
          "senderName": "Resumen de correos"
        }
      },
